@Metadata.layer: #CUSTOMER
@UI: {
  headerInfo: {
    typeName: 'Rate Sheet - KIT',
    typeNamePlural: 'Rate Sheet - KIT',
    title: { type: #STANDARD, value: 'BomComponent' }
  }
}
annotate view ZC_RSH_RAW with
{
  @UI.facet: [
    { id: 'idRawGeneral', type: #IDENTIFICATION_REFERENCE, label: 'BOM Within BOM', position: 10 }
  ]

  @UI.hidden: true
  RawMatCostUUID;
  @UI.hidden: true
  KitCostingUUID;
  @UI.hidden: true
  RateSheetUUID;

  @UI: { lineItem: [{ position: 5, label: 'Tick' }], identification: [{ position: 5, label: 'Tick' }] }
  IsSelectedForCosting;

  @UI: { lineItem: [{ position: 10, label: 'SR NO' }], identification: [{ position: 10, label: 'SR NO' }] }
  SrNo;

  @UI: { lineItem: [{ position: 20, label: 'BOM Component' }], identification: [{ position: 20, label: 'BOM Component' }] }
  BomComponent;

  @UI: { lineItem: [{ position: 30, label: 'Vendor Code' }], identification: [{ position: 30, label: 'Vendor Code' }] }
  VendorCode;

  @UI: { lineItem: [{ position: 40, label: 'Qty' }], identification: [{ position: 40, label: 'Qty' }] }
  Qty;

  @UI: { lineItem: [{ position: 50, label: 'UOM' }], identification: [{ position: 50, label: 'UOM' }] }
